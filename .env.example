# Hevy Pro API key from https://hevy.com/settings?developer
# Read on the server only. Do not prefix this with NEXT_PUBLIC_ and do not commit a real value.
HEVY_API_KEY=

# Used only when HEVY_API_KEY is unset.
# empty — 0 workouts, matching the current Hevy account
# sample — two Block 1 weeks (19–29 Oct 2026) so the charts have something to draw
HEVY_FIXTURE=empty

# IANA timezone for week buckets, streaks, and session dates.
HEVY_TIMEZONE=UTC
